#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        COPY: control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>;
            label = "CONTROL";
        };

        PASTE: PASTE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(V)>;
            label = "PASTE";
        };

        UN_DO: UNDO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(Z)>;
            label = "UNDO";
        };

        REDO: REDO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(Y)>;
            label = "REDO";
        };

        KUT: CUT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X)>;
            label = "CUT";
        };

        PASTE_NO_F: PASTE_NO_F {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(V))>;
            label = "PASTE_NO_F";
        };

        SPEC_PASTE: SPEC_PASTE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(LA(V)))>;
            label = "SPEC_PASTE";
        };

        SEL_ALL: SEL_ALL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(A)>;
            label = "SEL_ALL";
        };

        PRT_SCRN: PRT_SCRN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N4))>;
            label = "PRT_SCRN";
        };

        HOM: HOME {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>;
            label = "HOME";
        };

        ND: END {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(E)>;
            label = "END";
        };

        FIND: FIND {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(F)>;
            label = "FIND";
        };

        EMOJI: EMOJI {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(SPACE))>;
            label = "EMOJI";
        };

        SPOT_SEARCH: SPOT_SEARCH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "SPOT_SEARCH";
        };

        BOLD: BOLD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(B)>;
            label = "BOLD";
        };

        ITALIC: ITALIC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(I)>;
            label = "ITALIC";
        };

        U_LINE: U_LINE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(U)>;
            label = "U_LINE";
        };

        UPPER_CASE: UPPER_CASE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(C))>;
            label = "UPPER_CASE";
        };

        SUP_SCRIPT: UP_CASE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(PLUS))>;
            label = "UP_CASE";
        };

        SUB_SCRIPT: LO_CASE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(MINUS))>;
            label = "LO_CASE";
        };
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3  &kp N4          &kp N5     &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0             &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E   &kp R           &kp T      &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P              &kp BSLH
&kp LEFT_SHIFT    &kp A         &kp S         &kp D   &kp F           &kp G      &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L            &kp SEMI           &kp APOS
&kp LEFT_CONTROL  &kp Z         &kp X         &kp C   &kp V           &kp B      &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH           &kp ENTER
&to 1             &kp LEFT_ALT  &kp LEFT_GUI  &mo 1   &kp LEFT_SHIFT  &kp RET    &kp ENTER        &kp ENTER  &kp SPACE  &mo 2      &kp RIGHT_SHIFT  &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "LAYER 0";
        };

        layer_1 {
            bindings = <
&kp GRAVE     &kp F1       &kp F2    &kp F3  &kp F4       &kp F5         &mmv MOVE_UP     &kp F6     &kp F7    &kp F8      &kp F9     &kp F10           &trans
&kp CAPS      &SUP_SCRIPT  &U_LINE   &BOLD   &ITALIC      &UPPER_CASE    &mmv MOVE_DOWN   &kp PG_UP  &kp END   &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&trans        &SUB_SCRIPT  &SEL_ALL  &FIND   &SPEC_PASTE  &EMOJI         &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&SPOT_SEARCH  &UN_DO       &KUT      &COPY   &PASTE       &PASTE_NO_F    &mmv MOVE_RIGHT  &trans     &trans    &kp INSERT  &kp F11    &kp F12           &trans
&to 2         &trans       &trans    &trans  &trans       &trans         &mkp MB1         &trans     &trans    &trans      &trans     &trans
            >;

            display-name = "LAYER 1";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&kp TILDE  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_UP     &kp F6  &kp F7  &kp F8   &kp F9   &kp F10    &trans
&trans     &trans  &trans  &trans  &trans  &trans    &mmv MOVE_DOWN   &trans  &trans  &kp F11  &kp F12  &kp UNDER  &kp PLUS
&trans     &trans  &trans  &COPY   &trans  &trans    &mmv MOVE_LEFT   &trans  &trans  &trans   &trans   &kp LBRC   &kp RBRC
&trans     &trans  &trans  &trans  &trans  &trans    &mmv MOVE_RIGHT  &trans  &trans  &trans   &trans   &trans     &trans
&to 3      &trans  &trans  &trans  &trans  &trans    &to 1            &trans  &trans  &trans   &trans   &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "LAYER 2";
        };

        layer_3 {
            bindings = <
&trans       &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &trans
&trans       &bt BT_CLR    &bt BT_CLR_ALL  &out OUT_BLE  &out OUT_USB  &trans          &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans           &trans           &trans           &soft_off
&sys_reset   &trans        &trans          &trans        &trans        &trans          &trans  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &trans           &sys_reset
&bootloader  &trans        &trans          &trans        &trans        &trans          &trans  &trans           &trans           &trans           &trans           &trans           &bootloader
&to 0        &trans        &trans          &trans        &trans        &trans          &to 2   &trans           &trans           &trans           &trans           &trans
            >;

            label = "LAYER 3";
        };
    };
};
